// Synapse database schema.
// Connection URL lives in prisma.config.ts (Prisma 7), not here.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Platform {
  THREADS
  LINKEDIN
  TWITTER
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

// Per-platform delivery state. PARTIAL results live on Post.status = FAILED
// while the succeeded platforms keep PUBLISHED here.
enum PostPlatformStatus {
  PENDING
  /// Claimed by a publisher run; prevents double posting when jobs overlap
  PUBLISHING
  PUBLISHED
  FAILED
}

// ---------------------------------------------------------------------------
// App models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  /// Avatar URL
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth.js relations (login identity, e.g. Google)
  accounts Account[]
  sessions Session[]

  // Synapse relations
  socialAccounts SocialAccount[]
  posts          Post[]
}

/// A connected social platform account (Threads / LinkedIn / X).
/// Separate from Auth.js `Account`, which only stores the *login* identity.
model SocialAccount {
  id             String    @id @default(cuid())
  userId         String
  provider       Platform
  /// The user's id on the platform (X user id, LinkedIn member URN id, Threads user id)
  platformUserId String
  /// Display handle, e.g. "fatihkunak"
  username       String?
  displayName    String?
  avatarUrl      String?
  /// Stored AES-GCM encrypted (see TOKEN_ENCRYPTION_KEY), never plain text
  accessToken    String    @db.Text
  refreshToken   String?   @db.Text
  expiresAt      DateTime?
  scopes         String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  postPlatforms PostPlatform[]

  @@unique([userId, provider, platformUserId])
  @@index([userId])
  // Token refresh job scans for soon-to-expire tokens
  @@index([expiresAt])
}

model Post {
  id          String     @id @default(cuid())
  userId      String
  text        String     @db.Text
  mediaUrls   String[]
  status      PostStatus @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platforms PostPlatform[]

  @@index([userId, status])
  // The scheduler's hot query: SCHEDULED posts whose time has come
  @@index([status, scheduledAt])
}

/// Pivot: which post goes to which platform (via which connected account).
model PostPlatform {
  id              String             @id @default(cuid())
  postId          String
  platform        Platform
  socialAccountId String
  /// Id of the published post on the platform (tweet id, UGC post URN, Threads media id)
  publishedPostId String?
  status          PostPlatformStatus @default(PENDING)
  error           String?            @db.Text
  publishedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  // One delivery per platform per post
  @@unique([postId, platform])
  @@index([socialAccountId])
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) models, required by @auth/prisma-adapter.
// Field names (snake_case on Account) are mandated by the adapter.
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
