# Orvane environment variables. Copy to .env and fill in. Never commit real values.

# --- Database ---
DATABASE_URL="postgresql://user:password@host:5432/orvane?schema=public"
# Used by `prisma migrate` (use the non-pooled connection string on Supabase/Neon)
DIRECT_URL="postgresql://user:password@host:5432/orvane?schema=public"

# --- Auth.js (login) ---
AUTH_SECRET=""            # generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"  (or: npx auth secret)
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""         # Google Cloud Console → OAuth client; redirect: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_SECRET=""

# Public base URL of the app. Used for OAuth redirect URIs and for the media URLs publishers download.
# Defaults to AUTH_URL. Threads requires HTTPS, so for local Threads testing use a tunnel (e.g. cloudflared).
APP_URL=""

# --- Platform OAuth apps (Accounts page). Redirect URI for each: {APP_URL}/api/connect/<twitter|linkedin|threads>/callback ---
# X: every user adds their OWN X app in the app (Hesaplar page), so these two are ignored unless SHARED_X_APP=1 (private install, see below).
TWITTER_CLIENT_ID=""      # X developer portal → OAuth 2.0 (confidential client). Scopes: tweet.read tweet.write users.read media.write offline.access
TWITTER_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""     # needs the "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect" products
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_API_VERSION="202610"   # Posts API version (YYYYMM); keep within LinkedIn's supported window
THREADS_APP_ID=""         # Meta developer portal → Threads API. Permissions: threads_basic, threads_content_publish
THREADS_APP_SECRET=""

# --- Token encryption at rest (AES-256-GCM): 32 random bytes, base64 ---
TOKEN_ENCRYPTION_KEY=""   # generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"  (or: openssl rand -base64 32)

# --- Media storage ---
# Without it uploads go to ./.uploads (dev only; Threads cannot fetch localhost URLs).
CLOUDINARY_URL=""         # cloudinary://<api_key>:<api_secret>@<cloud_name>

# --- Background jobs (Inngest) ---
# Local: run `npx inngest-cli@latest dev -u http://localhost:3000/api/inngest` and leave these empty.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- AI writing (bring your own key) ---
# Keys are entered in the app (Settings > Yapay zeka), stored encrypted with TOKEN_ENCRYPTION_KEY and never sent back to the browser.
# Only for LOCAL development with Ollama / LM Studio / llama.cpp: lets the server call http and local addresses.
# NEVER enable this on anything reachable from outside: anyone who can sign in could aim the server at your local services.
# ALLOW_PRIVATE_LLM_URLS=1

# Service token for /api/admin/* (the fatihgo admin panel calls it server-to-server). At least 32 random characters
# (`openssl rand -base64 32`); unset or shorter keeps the admin API switched off. Put the same value in the panel's secrets.
# ORVANE_ADMIN_TOKEN=

# One-click update from /settings ("Sürüm ve güncelleme"). Off unless BOTH are set: the button runs deploy/update.cmd
# (git pull --ff-only, npm ci, prisma migrate deploy, build) and restarts the app, i.e. it executes code from the repository
# on this machine. Only the e-mail below sees the card; anything else is refused, admin token included.
# ORVANE_UPDATE_ENABLED=1
# ORVANE_OWNER_EMAIL=you@example.com
# Optional: another repository/branch to track (defaults to fatihkunak/orvane main)
# ORVANE_REPO=fatihkunak/orvane
# ORVANE_BRANCH=main

# X bills API usage to the app owner, so on a multi-user install every user adds their OWN X app (Hesaplar page) and the keys below
# are ignored. Set SHARED_X_APP=1 only for a private, single-owner install that should use TWITTER_CLIENT_ID/SECRET for everyone.
# SHARED_X_APP=1
